#!/bin/zsh
# rightconvert: convert images, video, audio, PDFs and documents locally.
#
#   rightconvert FILE...              pick a target format from a dialog
#   rightconvert --to FORMAT FILE...  convert without a dialog (e.g. --to webp, or --to webp-small)
#   rightconvert --list FILE          print the formats FILE can be converted to
#   rightconvert --matrix             print "EXT NORMALIZED_EXT CATEGORY TARGET..." for every known extension
#   rightconvert --gui ...            show notifications and dialogs even with --to
#
# Image targets are lossless where the format allows it. FORMAT-small variants of SMALLER_TARGETS
# trade a little quality for much smaller files.

setopt extended_glob null_glob pipe_fail

export PATH="/opt/homebrew/bin:/usr/local/bin:/Applications/LibreOffice.app/Contents/MacOS:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

LOG="$HOME/Library/Logs/rightconvert.log"
INTERACTIVE=1

typeset -A CATEGORY
for e in jpg png heic webp gif tiff bmp avif svg; do CATEGORY[$e]=image; done
for e in mp4 mov mkv avi webm m4v; do CATEGORY[$e]=video; done
for e in mp3 wav m4a aac flac ogg opus aiff; do CATEGORY[$e]=audio; done
CATEGORY[pdf]=pdf
for e in docx doc odt rtf txt md html; do CATEGORY[$e]=doc; done
for e in xlsx xls ods csv; do CATEGORY[$e]=sheet; done
for e in pptx ppt odp; do CATEGORY[$e]=slides; done

typeset -A TARGETS
TARGETS[image]="jpg png webp heic avif tiff gif bmp ico pdf"
TARGETS[video]="mp4 mov mkv webm gif mp3 m4a wav"
TARGETS[audio]="mp3 wav m4a flac ogg opus aiff"
TARGETS[pdf]="png jpg txt docx"
TARGETS[doc]="pdf docx doc odt rtf txt md html"
TARGETS[sheet]="xlsx xls ods csv pdf"
TARGETS[slides]="pptx ppt odp pdf"

typeset -A INSTALL_HINT
INSTALL_HINT[magick]="brew install imagemagick"
INSTALL_HINT[ffmpeg]="brew install ffmpeg"
INSTALL_HINT[pdftoppm]="brew install poppler"
INSTALL_HINT[pandoc]="brew install pandoc"
INSTALL_HINT[soffice]="brew install --cask libreoffice"

EXT_ALIASES=(jpeg tif heif htm markdown aif)

SMALLER_TARGETS=(webp heic avif)

PANDOC_IN=(docx odt rtf md html txt)
PANDOC_OUT=(docx odt rtf md html txt)
TEXTUTIL_FMT=(txt html rtf doc docx odt)
SOFFICE_IN=(docx doc odt rtf txt html)
SOFFICE_OUT=(pdf docx doc odt rtf txt html)

has() { command -v "$1" >/dev/null 2>&1 }

in_list() {  # in_list VALUE ITEM...
  local v=$1; shift
  local -a items=("$@")
  (( ${items[(Ie)$v]} ))
}

normalize_ext() {
  local e=${(L)1}
  case $e in
    jpeg) e=jpg ;;
    tif) e=tiff ;;
    heif) e=heic ;;
    htm) e=html ;;
    markdown) e=md ;;
    aif) e=aiff ;;
  esac
  print -r -- "$e"
}

ext_of() { normalize_ext "${1:t:e}" }

category_of() { print -r -- "${CATEGORY[$(ext_of "$1")]}" }

base_format() { print -r -- "${1%-small}" }  # webp-small -> webp

doc_engine() {
  local s=$1 t=$2
  if [[ $s == md ]]; then
    if [[ $t == pdf ]]; then
      has pandoc && has soffice && print pandoc+soffice
    elif in_list $t $PANDOC_OUT; then
      has pandoc && print pandoc
    fi
    return
  fi
  if [[ $t == md ]]; then
    in_list $s $PANDOC_IN && has pandoc && print pandoc
    return
  fi
  if [[ $t == pdf ]]; then
    in_list $s $SOFFICE_IN && has soffice && print soffice
    return
  fi
  if [[ $s == doc || $t == doc ]]; then
    if has textutil; then print textutil
    elif has soffice; then print soffice
    fi
    return
  fi
  if [[ $s != txt ]] && has pandoc && in_list $s $PANDOC_IN && in_list $t $PANDOC_OUT; then
    print pandoc
  elif has textutil && in_list $s $TEXTUTIL_FMT && in_list $t $TEXTUTIL_FMT; then
    print textutil
  elif has soffice && in_list $s $SOFFICE_IN && in_list $t $SOFFICE_OUT; then
    print soffice
  fi
}

engine_for() {  # engine_for SRC_EXT TARGET
  local s=$1 t=$(base_format $2)
  [[ $s == $t ]] && return
  case ${CATEGORY[$s]} in
    image) has magick && print magick ;;
    video|audio) has ffmpeg && print ffmpeg ;;
    pdf)
      case $t in
        png|jpg) has pdftoppm && print pdftoppm ;;
        txt) has pdftotext && print pdftotext ;;
        docx) has soffice && print soffice-pdf ;;
      esac ;;
    doc) doc_engine $s $t ;;
    sheet|slides) has soffice && print soffice ;;
  esac
}

targets_for() {  # targets_for FILE: formats FILE can be converted to with installed engines
  local s=$(ext_of "$1") t
  local cat=${CATEGORY[$s]}
  [[ -z $cat ]] && return
  for t in ${=TARGETS[$cat]}; do
    [[ -n $(engine_for $s $t) ]] || continue
    print -r -- $t
    [[ $cat == image ]] && in_list $t $SMALLER_TARGETS && print -r -- $t-small
  done
}

missing_engines_for() {  # engines whose absence limits what a category can produce
  case $1 in
    image) has magick || print magick ;;
    video|audio) has ffmpeg || print ffmpeg ;;
    pdf) has pdftoppm || print pdftoppm; has soffice || print soffice ;;
    doc) has pandoc || print pandoc; has soffice || print soffice ;;
    sheet|slides) has soffice || print soffice ;;
  esac
}

label_for() {  # label_for CATEGORY TARGET; keep in sync with label(for:) in FinderSync.swift
  local label=${(U)$(base_format $2)}
  case "$1:$2" in
    *-small) label+=" (smaller file)" ;;
    video:mp3|video:m4a|video:wav) label+=" (audio only)" ;;
    video:gif) label+=" (animated)" ;;
    pdf:png|pdf:jpg) label+=" (one image per page)" ;;
  esac
  print -r -- "$label"
}

log() { print -r -- "$*" >>"$LOG" }

rotate_log() {
  [[ -f $LOG ]] && (( $(stat -f %z "$LOG") > 5 * 1024 * 1024 )) && mv -f "$LOG" "$LOG.old"
  return 0
}

run() {
  log "+ ${(q-)@}"
  "$@" >>"$LOG" 2>&1
}

notify() {
  (( INTERACTIVE )) || return 0
  osascript - "$1" >/dev/null 2>&1 <<'EOF'
on run argv
  display notification (item 1 of argv) with title "Convert"
end run
EOF
}

alert() {
  if (( INTERACTIVE )); then
    osascript - "$1" >/dev/null 2>&1 <<'EOF'
on run argv
  activate
  display dialog (item 1 of argv) with title "Convert" buttons {"OK"} default button 1 with icon caution
end run
EOF
  else
    print -u2 -r -- "rightconvert: $1"
  fi
}

pick_format() {  # pick_format PROMPT LABEL...
  osascript - "$@" 2>/dev/null <<'EOF'
on run argv
  set thePrompt to item 1 of argv
  set theItems to rest of argv
  activate
  set choice to choose from list theItems with title "Convert" with prompt thePrompt OK button name "Convert" default items {item 1 of theItems}
  if choice is false then return ""
  return item 1 of choice
end run
EOF
}

unique_path() {  # unique_path STEM SUFFIX
  local candidate="$1$2" n=1
  while [[ -e $candidate ]]; do
    candidate="$1-$n$2"
    (( n++ ))
  done
  print -r -- "$candidate"
}

soffice_spec() {
  case $1 in
    txt) print -r -- 'txt:Text (encoded):UTF8' ;;
    csv) print -r -- 'csv:Text - txt - csv (StarCalc):44,34,76,1' ;;
    docx) print -r -- 'docx:MS Word 2007 XML' ;;
    *) print -r -- $1 ;;
  esac
}

soffice_convert() {  # soffice_convert IN TARGET OUT [INFILTER]
  local in=$1 t=$2 out=$3 infilter=$4
  local tmp=$(mktemp -d -t rightconvert)
  local -a pre=()
  [[ -n $infilter ]] && pre=("--infilter=$infilter")
  run soffice --headless --norestore "-env:UserInstallation=file://$tmp/profile" \
    $pre --convert-to "$(soffice_spec $t)" --outdir "$tmp/out" "$in"
  local -a produced=("$tmp"/out/*.$t)
  local ok=1
  if (( ${#produced} )); then
    mv "$produced[1]" "$out" && ok=0
  fi
  rm -rf "$tmp"
  return $ok
}

pandoc_convert() {  # pandoc_convert IN SRC_EXT TARGET OUT
  local in=$1 s=$2 t=$3 out=$4
  local from=$s to=$t
  [[ $s == md || $s == txt ]] && from=markdown
  [[ $t == md ]] && to=gfm
  [[ $t == txt ]] && to=plain
  local -a extra=(--standalone)
  [[ $t == html ]] && extra+=(--metadata "pagetitle=${in:t:r}")
  [[ $t == html ]] && in_list $s docx odt && extra+=(--embed-resources)
  [[ $t == md ]] && in_list $s docx odt && extra+=("--extract-media=${out:t:r}_media")
  ( cd "${in:h}" && run pandoc --from $from --to $to $extra --output "$out" "$in" )
}

image_convert() {  # image_convert IN SRC_EXT TARGET OUT
  local in=$1 s=$2 t=$(base_format $3) out=$4
  local small=0
  [[ $3 == *-small ]] && small=1
  local src=$in
  local -a pre=() opts=(-auto-orient)
  [[ $s == svg ]] && pre=(-background none -density 288)
  # Single-frame formats take only the first frame of animated or multi-page input.
  in_list $t jpg png bmp ico heic avif && src="${in}[0]"

  # ImageMagick's HEIF writer always goes through lossy YUV; heif-enc -L encodes RGB losslessly.
  if (( ! small )) && [[ $t == (heic|avif) ]] && has heif-enc; then
    local tmp=$(mktemp -d -t rightconvert) rc
    run magick $pre "$src" $opts "$tmp/frame.png" \
      && run heif-enc -L $([[ $t == avif ]] && print -- -A) "$tmp/frame.png" -o "$out"
    rc=$?
    rm -rf "$tmp"
    (( rc == 0 )) && return 0
    log "lossless $t encode failed; using high-quality lossy encode"
  fi

  case $t in
    jpg) opts+=(-background white -alpha remove -alpha off -quality 95 -sampling-factor 4:4:4) ;;
    webp)
      if (( small )); then opts+=(-quality 85 -define webp:use-sharp-yuv=true -define webp:method=6)
      else opts+=(-define webp:lossless=true -define webp:exact=true -quality 100)
      fi ;;
    # Smaller-file qualities measured to stay above 40 dB PSNR (see tests/quality.sh).
    heic) (( small )) && opts+=(-quality 60) || opts+=(-quality 95 -define heic:chroma=444) ;;
    avif) (( small )) && opts+=(-quality 70) || opts+=(-quality 95 -define heic:chroma=444) ;;
    # Without an explicit lossless codec, ImageMagick may reuse a JPEG source's compression.
    tiff|pdf) opts+=(-compress zip) ;;
    png) opts+=(-define png:compression-level=9) ;;
    ico) opts+=(-background none -resize '256x256>' -define icon:auto-resize=256,128,64,48,32,16) ;;
  esac
  run magick $pre "$src" $opts "$out"
}

LOSSLESS_AUDIO=(flac alac wavpack ape tta truehd mlp pcm_u8 pcm_s16le pcm_s16be pcm_s24le pcm_s24be
                pcm_s32le pcm_s32be pcm_f32le pcm_f32be pcm_f64le pcm_f64be)

# Codecs each container can hold as-is, so they're copied instead of re-encoded. MKV holds anything.
typeset -A VIDEO_COPY AUDIO_COPY
VIDEO_COPY[mp4]="h264 hevc av1 mpeg4"
VIDEO_COPY[mov]="h264 hevc av1 mpeg4 prores mjpeg"
VIDEO_COPY[webm]="vp8 vp9 av1"
AUDIO_COPY[mp4]="aac mp3 alac ac3 eac3 opus flac"
AUDIO_COPY[mov]="aac mp3 alac ac3 eac3 pcm_s16le pcm_s24le pcm_s16be pcm_s24be pcm_f32le"
AUDIO_COPY[webm]="opus vorbis"

probe() {  # probe FILE STREAM ENTRY: first value of ENTRY for the selected stream
  ffprobe -v error -select_streams $2 -show_entries stream=$3 -of default=nw=1:nk=1 "$1" 2>/dev/null | head -n1
}

has_encoder() { ffmpeg -hide_banner -encoders 2>/dev/null | grep -q " $1 " }

pcm_depth() {  # pcm_depth FILE: s16, s24, s32 or f32, matching the source's precision
  local fmt=$(probe "$1" a:0 sample_fmt) bits=$(probe "$1" a:0 bits_per_raw_sample)
  local codec=$(probe "$1" a:0 codec_name)
  case $fmt in
    u8*|s16*) print s16 ;;
    s32*) [[ $bits == 24 ]] && print s24 || print s32 ;;
    # Float decoders: keep real float sources exact; 24-bit is beyond transparent for lossy ones.
    *) in_list "$codec" $LOSSLESS_AUDIO && print f32 || print s24 ;;
  esac
}

audio_args() {  # audio_args FILE TARGET: sets $reply to the -c:a options for TARGET
  local in=$1 t=$2
  local codec=$(probe "$in" a:0 codec_name)
  local depth=$(pcm_depth "$in")
  local lossless=0
  in_list "$codec" $LOSSLESS_AUDIO && lossless=1
  local planar_fmt=s32p packed_fmt=s32
  [[ $depth == s16 ]] && planar_fmt=s16p packed_fmt=s16
  case $t in
    mp3) [[ $codec == mp3 ]] && reply=(-c:a copy) || reply=(-c:a libmp3lame -b:a 320k) ;;
    m4a)
      if [[ $codec == aac || $codec == alac ]]; then reply=(-c:a copy)
      elif (( lossless )); then reply=(-c:a alac -sample_fmt $planar_fmt)
      else reply=(-c:a aac -b:a 320k)
      fi ;;
    ogg)
      if [[ $codec == opus || $codec == vorbis ]]; then reply=(-c:a copy)
      elif has_encoder libvorbis; then reply=(-c:a libvorbis -q:a 10)
      else reply=(-c:a libopus -b:a 256k)
      fi ;;
    opus) [[ $codec == opus ]] && reply=(-c:a copy) || reply=(-c:a libopus -b:a 256k) ;;
    flac) [[ $codec == flac ]] && reply=(-c:a copy) || reply=(-c:a flac -compression_level 8 -sample_fmt $packed_fmt) ;;
    wav) reply=(-c:a pcm_${depth}le) ;;
    aiff) [[ $depth == f32 ]] && reply=(-c:a pcm_s32be) || reply=(-c:a pcm_${depth}be) ;;
  esac
  [[ $depth == s24 && $reply[2] == (flac|alac) ]] && reply+=(-bits_per_raw_sample 24)
}

video_args() {  # video_args FILE TARGET MODE: sets $reply; MODE=best copies streams when possible
  local in=$1 t=$2 mode=$3
  local vcodec=$(probe "$in" v:0 codec_name) acodec=$(probe "$in" a:0 codec_name)
  local pix=$(probe "$in" v:0 pix_fmt)
  local -a v a maps=(-map 0:v:0 -map '0:a?')

  if [[ $mode == best ]] && { [[ $t == mkv ]] || in_list "$vcodec" ${=VIDEO_COPY[$t]} }; then
    v=(-c:v copy)
    [[ $vcodec == hevc && $t != (mkv|webm) ]] && v+=(-tag:v hvc1)
  elif [[ $pix == *1[02](le|be) ]]; then
    # 10/12-bit (HDR) sources stay 10-bit.
    if [[ $t == webm ]]; then v=(-c:v libvpx-vp9 -profile:v 2 -pix_fmt yuv420p10le -crf 12 -b:v 0 -row-mt 1)
    else v=(-c:v libx265 -preset medium -crf 16 -pix_fmt yuv420p10le -tag:v hvc1)
    fi
  else
    # 4:2:0 needs even dimensions; crop one pixel rather than rescale.
    v=(-vf 'crop=trunc(iw/2)*2:trunc(ih/2)*2')
    if [[ $t == webm ]]; then v+=(-c:v libvpx-vp9 -pix_fmt yuv420p -crf 12 -b:v 0 -row-mt 1 -deadline good -cpu-used 2)
    else v+=(-c:v libx264 -preset slow -crf 16 -pix_fmt yuv420p)
    fi
  fi

  if [[ -z $acodec ]]; then
    a=()
  elif [[ $mode == best ]] && { [[ $t == mkv ]] || in_list "$acodec" ${=AUDIO_COPY[$t]} }; then
    a=(-c:a copy)
  elif [[ $t == webm ]]; then
    a=(-c:a libopus -b:a 256k)
  elif in_list "$acodec" $LOSSLESS_AUDIO; then
    local depth=$(pcm_depth "$in")
    a=(-c:a alac -sample_fmt $([[ $depth == s16 ]] && print s16p || print s32p))
  else
    a=(-c:a aac -b:a 320k)
  fi

  [[ $t == mkv && $mode == best ]] && maps+=(-map '0:s?') && a+=(-c:s copy)
  reply=($maps $v $a)
  [[ $t == (mp4|mov) ]] && reply+=(-movflags +faststart)
}

gif_args() {  # gif_args FILE: full resolution, frame rate capped at 30 fps, best 256-color palette
  local rate=$(probe "$1" v:0 r_frame_rate)
  [[ $rate == <1->/<1-> ]] || rate=30/1
  local fps=$(( ${rate%/*} / ${${rate#*/}:-1}.0 ))
  local filter='split[a][b];[a]palettegen=max_colors=256:stats_mode=full[p];[b][p]paletteuse=dither=sierra2_4a'
  (( fps > 30 )) && filter="fps=30,$filter"
  reply=(-an -map 0:v:0 -vf $filter -loop 0)
}

av_convert() {  # av_convert IN TARGET OUT
  local in=$1 t=$2 out=$3 mode
  local cat=${CATEGORY[$(ext_of "$in")]}
  local -a args
  for mode in best safe; do
    case $t in
      mp4|mov|mkv|webm) video_args "$in" $t $mode; args=($reply) ;;
      gif) gif_args "$in"; args=($reply) ;;
      *)
        audio_args "$in" $t
        [[ $mode == safe && $reply[2] == copy ]] && audio_args_reencode "$in" $t
        args=(-map 0:a:0 $reply)
        # Keep embedded cover art when the target supports it.
        if [[ $mode == best && $cat == audio && $t == (mp3|m4a|flac) && -n $(probe "$in" v:0 codec_name) ]]; then
          args+=(-map 0:v:0 -c:v copy -disposition:v:0 attached_pic)
        else
          args+=(-vn)
        fi ;;
    esac
    run ffmpeg -nostdin -hide_banner -loglevel error -y -i "$in" $args "$out" && return 0
    [[ $t == gif ]] && return 1
    log "retrying without stream copy"
  done
  return 1
}

audio_args_reencode() {  # like audio_args, but never copies the source stream
  local in=$1 t=$2
  case $t in
    mp3) reply=(-c:a libmp3lame -b:a 320k) ;;
    m4a) reply=(-c:a aac -b:a 320k) ;;
    ogg|opus) reply=(-c:a libopus -b:a 256k) ;;
    flac) reply=(-c:a flac -compression_level 8) ;;
  esac
}

convert_one() {  # convert_one IN TARGET; prints the output path on success
  local in=${1:A} t=$2
  local s=$(ext_of "$in")
  local stem="${in:h}/${in:t:r}"
  local engine=$(engine_for $s $t)
  [[ -z $engine ]] && { log "no engine for $s -> $t: $in"; return 1 }

  local out
  if [[ $engine == pdftoppm ]]; then
    out=$(unique_path "$stem-pages" "")
    mkdir -p "$out"
  else
    out=$(unique_path "$stem" ".$(base_format $t)")
  fi

  local ok=1
  case $engine in
    magick) image_convert "$in" $s $t "$out" && ok=0 ;;
    ffmpeg) av_convert "$in" $t "$out" && ok=0 ;;
    pdftoppm)
      if [[ $t == png ]]; then run pdftoppm -r 300 -png "$in" "$out/page" && ok=0
      else run pdftoppm -r 300 -jpeg -jpegopt quality=95 "$in" "$out/page" && ok=0
      fi ;;
    pdftotext) run pdftotext -layout "$in" "$out" && ok=0 ;;
    soffice-pdf) soffice_convert "$in" $t "$out" writer_pdf_import && ok=0 ;;
    soffice) soffice_convert "$in" $t "$out" && ok=0 ;;
    textutil) run textutil -convert $t -output "$out" "$in" && ok=0 ;;
    pandoc) pandoc_convert "$in" $s $t "$out" && ok=0 ;;
    pandoc+soffice)
      local tmp=$(mktemp -d -t rightconvert)
      pandoc_convert "$in" $s docx "$tmp/${in:t:r}.docx" \
        && soffice_convert "$tmp/${in:t:r}.docx" $t "$out" && ok=0
      rm -rf "$tmp" ;;
  esac

  if (( ok )) || [[ ! -e $out ]]; then
    rm -rf "$out"
    return 1
  fi
  print -r -- "$out"
}

print_matrix() {
  local raw norm
  for raw in ${(ok)CATEGORY} $EXT_ALIASES; do
    norm=$(normalize_ext $raw)
    print -r -- "$raw $norm ${CATEGORY[$norm]} ${(f)$(targets_for "x.$raw")}"
  done
}

usage() {
  cat <<'EOF'
Usage:
  rightconvert FILE...              pick a target format from a dialog
  rightconvert --to FORMAT FILE...  convert without a dialog
  rightconvert --list FILE          print the formats FILE can be converted to
  rightconvert --matrix             print the conversion table for all known extensions
  rightconvert --gui ...            show notifications and dialogs even with --to

FORMAT is a file extension such as jpg, mp4 or pdf. webp-small, heic-small and avif-small
make smaller lossy images instead of lossless ones.
Folders are expanded one level deep. Output is written next to each source file.
EOF
}

main() {
  local target="" list_only=0 gui=0
  local -a args=()
  while (( $# )); do
    case $1 in
      --to)
        (( $# >= 2 )) || { print -u2 "rightconvert: --to needs a format"; return 2 }
        target=$(normalize_ext "$2"); INTERACTIVE=0; shift 2 ;;
      --to=*) target=$(normalize_ext "${1#--to=}"); INTERACTIVE=0; shift ;;
      --list) list_only=1; INTERACTIVE=0; shift ;;
      --matrix) print_matrix; return 0 ;;
      --gui) gui=1; shift ;;
      -h|--help) usage; return 0 ;;
      --) shift; args+=("$@"); break ;;
      -*) print -u2 "rightconvert: unknown option $1"; usage >&2; return 2 ;;
      *) args+=("$1"); shift ;;
    esac
  done
  (( gui )) && INTERACTIVE=1

  mkdir -p "${LOG:h}"
  rotate_log

  if (( list_only )); then
    (( ${#args} == 1 )) || { usage >&2; return 2 }
    targets_for "$args[1]"
    return 0
  fi

  local -a files=() skipped=()
  local f g
  for f in $args; do
    if [[ -d $f ]]; then
      for g in "$f"/*(.N); do
        [[ -n $(category_of "$g") ]] && files+=("$g")
      done
    elif [[ -f $f && -n $(category_of "$f") ]]; then
      files+=("$f")
    else
      skipped+=("$f")
    fi
  done

  if (( ! ${#files} )); then
    if (( ${#args} )); then alert "None of the selected items are a supported file type."
    else usage >&2
    fi
    return 1
  fi

  local -a common=() owns=() cats=() list
  local first=1 own c
  for f in $files; do
    own=$(ext_of "$f")
    owns+=($own)
    cats+=(${CATEGORY[$own]})
    list=($(targets_for "$f") $own)
    if (( first )); then common=($list); first=0
    else common=(${common:*list})
    fi
  done
  owns=(${(u)owns})
  cats=(${(u)cats})
  (( ${#owns} == 1 )) && common=(${common:#$owns[1]})

  if (( ! ${#common} )); then
    local -a missing=()
    for c in $cats; do missing+=($(missing_engines_for $c)); done
    missing=(${(u)missing})
    if (( ${#missing} )); then
      local hints=""
      local m
      for m in $missing; do hints+=$'\n'"  ${INSTALL_HINT[$m]}"; done
      alert "No output formats are available for this selection. Install the missing converters:$hints"
    else
      alert "The selected files don't share an output format. Select files of one kind and try again."
    fi
    return 1
  fi

  if [[ -z $target ]]; then
    local prompt
    if (( ${#files} == 1 )); then prompt="Convert \"${files[1]:t}\" to:"
    else prompt="Convert ${#files} files to:"
    fi
    local -a labels=()
    local cat=${cats[1]}
    (( ${#cats} > 1 )) && cat=mixed
    for c in $common; do labels+=("$(label_for $cat $c)"); done
    local choice=$(pick_format "$prompt" $labels)
    [[ -z $choice ]] && return 0
    local index=${labels[(ie)$choice]}
    (( index <= ${#common} )) || return 1
    target=$common[$index]
  elif ! in_list $target $common; then
    alert "Can't convert the selected files to '$target'. Available: ${(j:, :)common}"
    return 1
  fi

  local name=$(label_for "" $target)
  log "=== $(date '+%Y-%m-%d %H:%M:%S') converting ${#files} file(s) to $target"
  notify "Converting ${#files} file(s) to $name..."

  local done_count=0 fail_count=0 same_count=0 out
  local -a failed=()
  for f in $files; do
    if [[ $(ext_of "$f") == $(base_format $target) ]]; then
      (( same_count++ ))
      continue
    fi
    if out=$(convert_one "$f" $target); then
      (( done_count++ ))
      print -r -- "$out"
      log "ok: $f -> $out"
    else
      (( fail_count++ ))
      failed+=("${f:t}")
      log "FAILED: $f -> $target"
      print -u2 -r -- "rightconvert: failed to convert $f (see $LOG)"
    fi
  done

  local summary="Converted $done_count file(s) to $name."
  (( same_count )) && summary+=" Skipped $same_count already in ${(U)$(base_format $target)}."
  (( ${#skipped} )) && summary+=" Skipped ${#skipped} unsupported."
  if (( fail_count )); then
    summary+=" $fail_count failed: ${(j:, :)failed}. Details in ~/Library/Logs/rightconvert.log"
    alert "$summary"
    return 1
  fi
  notify "$summary"
  return 0
}

main "$@"
