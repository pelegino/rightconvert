#!/usr/bin/env python3
"""rightconvert: convert images, video, audio, PDFs and documents locally. See --help."""

import os
import sys

# Bytecode caches would modify the signed macOS app bundle and the installed Windows folder.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from rightconvert.cli import main  # noqa: E402

sys.exit(main())
